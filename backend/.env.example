# Copy this file to .env and fill in real values. Never commit .env.

# ---- Server ----
PORT=4000
# Comma-separated list of origins allowed to call this API.
# In production this should be your real domain, e.g. https://charmentist.com
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:5500

# Where the SQLite database file lives. Leave blank for local dev
# (it defaults to backend/db/data.sqlite). In production on Railway/
# Render, set this to a path INSIDE a persistent volume you attach to
# the service — e.g. DB_PATH=/data/data.sqlite with a volume mounted
# at /data — otherwise every redeploy wipes all users/orders/products.
DB_PATH=

# Your live storefront URL, used to build links inside emails (e.g. the
# password-reset link). No trailing slash.
FRONTEND_URL=https://yourdomain.com

# Shared secret required in the "x-admin-key" header to use the admin API
# (create/edit products, view all orders). Generate one the same way as
# JWT_SECRET below and keep it private.
ADMIN_KEY=change-this-too

# Optional. If set, an email is sent here every time a new order comes
# in, so staff don't have to keep the admin dashboard open to notice it.
# Leave blank to disable.
ADMIN_EMAIL=orders@yourdomain.com

# ---- Auth ----
# Any long random string. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=30d

# ---- Midtrans (payment gateway) ----
# Get these from https://dashboard.midtrans.com after creating a free account.
# Use the SANDBOX keys while testing, SANDBOX -> PRODUCTION switch happens
# automatically based on MIDTRANS_IS_PRODUCTION.
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxxxxxxxxxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxxxxxxx
MIDTRANS_IS_PRODUCTION=false

# ---- Email (order confirmations, password reset) ----
# Any SMTP provider works (Gmail app password, Resend, SendGrid SMTP, etc).
# Example below is for Resend's SMTP relay.
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=your-smtp-password-or-api-key
MAIL_FROM="CHARMENTIST <orders@yourdomain.com>"
